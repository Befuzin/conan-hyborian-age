<header class="item-header">
  <img src="{{item.img}}" data-edit="img" data-action="editImage" title="{{item.name}}" />
  <div class="flexcol">
    <div class="name-title redcolor">
      {{formInput
        fields.name
        name="name"
        value=item._source.name
        placeholder=(localize "Name")
        disabled=locked
      }}
    </div>
      {{> "systems/conan-hyborian-age/templates/sheets/parts/unlock-icon.hbs"}}
  </div>
</header>