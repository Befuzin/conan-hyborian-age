<header class="npc-header">
    <div class="player-portrait std-contextmenu" data-group="portrait">
        {{#if unlocked}}
        <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img" title="{{actor.name}}">
        {{else if (ne actor.img "icons/svg/mystery-man.svg")}}
        <img src="{{actor.img}}" title="{{actor.name}}" />
        {{/if}}
    </div>
    <div class="name-line">
        {{#if unlocked}}
        <div class="line-label">{{localize 'CONAN.LABEL.name'}}</div>
        {{/if}}
        <input name="name" type="text" value="{{actor.name}}" />
    </div>
    <div class="type-line">
      {{formGroup systemFields.classification value=system.classification classes="line-label" disabled=locked}}
      {{formGroup systemFields.ennemyType value=system.ennemyType classes="line-label" disabled=locked}}
    </div>
    {{! Sheet Navigation }}
    <div class="right-icons">
        {{> "systems/conan-hyborian-age/templates/sheets/parts/unlock-icon.hbs"}}
        <nav class="sheet-tabs tabs tablist" aria-roledescription="{{localize 'SHEETS.FormNavLabel'}}">
        {{#each tabs as |tab|}}
        <a class="choix_tab {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}"
            {{#if tab.tooltip}}data-tooltip="{{tab.tooltip}}"{{/if}}>
            {{#if tab.icon}}<i class="{{tab.icon}}"></i>{{/if}}
            {{#if tab.label}}<label>{{localize tab.label}}</label>{{/if}}
        </a>
        {{/each}}
        </nav>
    </div>
</header>