<section class="tab skills {{tab.cssClass}}" data-group="primary" data-tab="skills">
    <div class="npcattributes-grid borderleft borderright">
        <div class="stat-label std-contextmenu {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" data-group="stats" data-statname="might" style="grid-row:1/2; grid-column:1/3;" title="{{localize 'CONAN.INFO.rightclick'}}">{{localize "CONAN.ATTRIBUTES.might.label"}}</div>
        <div class="stat-value std-contextmenu borderright" data-group="stats" data-statname="might" style="grid-row:2/3; grid-column:1/2;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formInput systemFields.attributes.fields.might.fields.value value=system.attributes.might.value type="number"}}
            {{else}}
            {{system.attributes.might.value}}
            {{/if}}
        </div>
        <div class="stat-dice std-contextmenu borderright" data-group="stats" data-statname="might" style="grid-row:2/3; grid-column:2/3;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formGroup systemFields.attributes.fields.might.fields.dice value=system.attributes.might.dice}}
            {{else}}
            {{attributes.might.dicelabel}}
            {{/if}}
        </div>
        <div class="stat-label std-contextmenu {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" data-group="stats" data-statname="edge" style="grid-row:1/2; grid-column:3/5;" title="{{localize 'CONAN.INFO.rightclick'}}">{{localize "CONAN.ATTRIBUTES.edge.label"}}</div>
        <div class="stat-value std-contextmenu borderright" data-group="stats" data-statname="edge" style="grid-row:2/3; grid-column:3/4;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formInput systemFields.attributes.fields.edge.fields.value value=system.attributes.edge.value type="number"}}
            {{else}}
            {{system.attributes.edge.value}}
            {{/if}}
        </div>
        <div class="stat-dice std-contextmenu borderright" data-group="stats" data-statname="edge" style="grid-row:2/3; grid-column:4/5;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formGroup systemFields.attributes.fields.edge.fields.dice value=system.attributes.edge.dice}}
            {{else}}
            {{attributes.edge.dicelabel}}
            {{/if}}
        </div>
        <div class="stat-label std-contextmenu {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" data-group="stats" data-statname="grit" style="grid-row:1/2; grid-column:5/7;" title="{{localize 'CONAN.INFO.rightclick'}}">{{localize "CONAN.ATTRIBUTES.grit.label"}}</div>
        <div class="stat-value std-contextmenu borderright" data-group="stats" data-statname="grit" style="grid-row:2/3; grid-column:5/6;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formInput systemFields.attributes.fields.grit.fields.value value=system.attributes.grit.value type="number"}}
            {{else}}
            {{system.attributes.grit.value}}
            {{/if}}
        </div>
        <div class="stat-dice std-contextmenu borderright" data-group="stats" data-statname="grit" style="grid-row:2/3; grid-column:6/7;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formGroup systemFields.attributes.fields.grit.fields.dice value=system.attributes.grit.dice}}
            {{else}}
            {{attributes.grit.dicelabel}}
            {{/if}}
        </div>
        <div class="stat-label std-contextmenu {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" data-group="stats" data-statname="wits" style="grid-row:1/2; grid-column:7/9;" title="{{localize 'CONAN.INFO.rightclick'}}">{{localize "CONAN.ATTRIBUTES.wits.label"}}</div>
        <div class="stat-value std-contextmenu borderright" data-group="stats" data-statname="wits" style="grid-row:2/3; grid-column:7/8;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formInput systemFields.attributes.fields.wits.fields.value value=system.attributes.wits.value type="number"}}
            {{else}}
            {{system.attributes.wits.value}}
            {{/if}}
        </div>
        <div class="stat-dice std-contextmenu" data-group="stats" data-statname="wits" style="grid-row:2/3; grid-column:8/9;" title="{{localize 'CONAN.INFO.rightclick'}}">
            {{#if unlocked}}
            {{formGroup systemFields.attributes.fields.wits.fields.dice value=system.attributes.wits.dice}}
            {{else}}
            {{attributes.wits.dicelabel}}
            {{/if}}
        </div>
        <div class="stat-label {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" style="grid-row:3/4; grid-column:1/3;">{{localize "CONAN.LABEL.physicaldef"}}</div>
        <div class="def-value borderright" style="grid-row:4/5; grid-column:1/3;">
            {{#if unlocked}}
            {{formInput systemFields.defence.fields.physical.fields.value value=system.defence.physical.value type="number"}}
            {{else}}
            {{system.defence.physical.value}}
            {{/if}}
        </div>
        <div class="stat-label {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" style="grid-row:3/4; grid-column:3/5;">{{localize "CONAN.LABEL.sorcerydef"}}</div>
        <div class="def-value borderright" style="grid-row:4/5; grid-column:3/5;">
            {{#if unlocked}}
            {{formInput systemFields.defence.fields.sorcery.fields.value value=system.defence.sorcery.value type="number"}}
            {{else}}
            {{system.defence.sorcery.value}}
            {{/if}}
        </div>
        <div class="stat-label {{#if (eq system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}" style="grid-row:3/4; grid-column:5/7;">{{localize "CONAN.LABEL.ar"}}</div>
        <div class="def-value borderright" style="grid-row:4/5; grid-column:5/7;">
            {{#if unlocked}}
            {{formInput systemFields.ar.fields.value value=system.ar.value type="number"}}
            {{else}}
            {{system.ar.value}}
            {{/if}}
        </div>
        {{#if (eq system.ennemyType "antagonist")}}
        <div class="stat-label antagonist-back" style="grid-row:3/4; grid-column:7/9;">{{localize "CONAN.LABEL.lifePoints"}}</div>
        <div class="def-value input_life current_life" style="grid-row:4/5; grid-column:7/8;">
            {{formInput systemFields.life.fields.value value=system.life.value}}
        </div>
        <div class="def-value input_life" style="grid-row:4/5; grid-column:8/9;">
            {{#if unlocked}}
                {{formInput systemFields.life.fields.max value=system.life.max}}
            {{else}}
                {{actor.system.life.max}}
            {{/if}}
        </div>
        {{else}}
        <div class="stat-label minion-back" style="grid-row:3/4; grid-column:7/9;">{{localize "CONAN.LABEL.threshold"}}</div>
        <div class="def-value" style="grid-row:4/5; grid-column:7/9;">
            {{#if unlocked}}
            {{formInput systemFields.threshold value=system.threshold type="number"}}
            {{else}}
            {{system.threshold}}
            {{/if}}
        </div>
        {{/if}}
    </div>
    {{#if unlocked}}
    <div class="addweapon">
        <i class="fas fa-plus" data-action="newItem" data-field="weapon" title="{{localize 'CONAN.NEW.weapon'}}"></i>
    </div>
    {{/if}}
    {{#each weapons as |weapon id|}}
        <div class="item-contextmenu" data-item-id="{{weapon._id}}" title="{{localize 'CONAN.INFO.rightclick'}}">
        <details>
            <summary class="weapon">
                <div class="npcweapongrid">
                    <div class="weapon-value {{#if (eq ../system.ennemyType "antagonist")}}antagonist-back{{else}}minion-back{{/if}}">{{getLabel "WEAPON_TYPES" weapon.system.weaponType}}</div>
                    <div class="weapon-name borderright">{{weapon.name}}</div>
                    <div class="weapon-info borderright">{{getLabel "RANGES" weapon.system.range}}</div>
                    <div class="weapon-info">{{weapon.system.damage}}</div>
                </div>
            </summary>
            <div class="description">{{{lookup ../enrichedItemDescriptions weapon._id}}}</div>
        </details>
        </div>
    {{/each}}
    {{#if unlocked}}
    <div class="plusicon">
        <i class="fas fa-plus" data-action="newItem" data-field="npcability" title="{{localize 'CONAN.NEW.npcability'}}"></i>
    </div>
    {{/if}}
    {{#each npcabilities as |npcability id|}}
        <div class="npcability item-contextmenu" data-item-id="{{npcability._id}}"><a class="ability-name">{{{npcability.name}}}</a><a class="ability-desc">{{{lookup ../enrichedItemDescriptions npcability._id}}}</a></div>
    {{/each}}
    {{#each spells as |spell id|}}
        <div class="npcability item-contextmenu" data-item-id="{{spell._id}}"><a class="ability-name">{{{spell.name}}}</a><a class="ability-desc">{{{lookup ../enrichedItemDescriptions spell._id}}}</a></div>
    {{/each}}
</section>